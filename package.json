{
  "name": "crewly",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "prepare": "husky",
    "dev:frontend": "pnpm --filter crewly-frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build:frontend": "pnpm --filter crewly-frontend build",
    "build:backend": "pnpm --filter backend build",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test:frontend": "pnpm --filter crewly-frontend test",
    "test:backend": "pnpm --filter backend test",
    "test": "pnpm test:backend",
    "lint:backend": "pnpm --filter backend exec eslint \"{src,apps,libs,test}/**/*.ts\" --cache",
    "lint:frontend": "pnpm --filter crewly-frontend exec eslint . --cache",
    "lint": "pnpm lint:backend && pnpm lint:frontend"
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d",
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
