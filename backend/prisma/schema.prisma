}

model SeekerJobMatch {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId     String    @map("candidate_id") @db.Uuid
  discoveredJobId String    @map("discovered_job_id") @db.Uuid
  score           Int
  explanation     String?
  strengths       String[]
  gaps            String[]
  scoredAt        DateTime  @default(now()) @map("scored_at") @db.Timestamptz

  candidate     Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  discoveredJob DiscoveredJob @relation(fields: [discoveredJobId], references: [id], onDelete: Cascade)

  @@unique([candidateId, discoveredJobId])
  @@index([candidateId, score(sort: Desc)], map: "idx_seeker_job_matches_candidate")
  @@map("seeker_job_matches")
}

model SeekerApplication {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId     String    @map("candidate_id") @db.Uuid
  discoveredJobId String    @map("discovered_job_id") @db.Uuid
  status          String    @default("queued")
  source          String
  coverLetter     String?   @map("cover_letter")
  hhNegotiationId String?   @map("hh_negotiation_id")
  error           String?
  appliedAt       DateTime? @map("applied_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  candidate     Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  discoveredJob DiscoveredJob @relation(fields: [discoveredJobId], references: [id], onDelete: Cascade)

  @@unique([candidateId, discoveredJobId])
  @@index([candidateId], map: "idx_seeker_applications_candidate")
  @@index([status], map: "idx_seeker_applications_status")
  @@map("seeker_applications")
}

model DiscoveredJob {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source         String
  externalId     String?   @map("external_id")
  sourceUrl      String    @unique @map("source_url")
  title          String
  company        String
  location       String?
  description    String?
  skills         String[]
  salaryMinUzs   BigInt?   @map("salary_min_uzs")
  salaryMaxUzs   BigInt?   @map("salary_max_uzs")
  employmentType String?   @map("employment_type")
  workMode       String?   @map("work_mode")
  status         String    @default("active")
  postedAt       DateTime? @map("posted_at") @db.Timestamptz
  rawPayload     Json      @map("raw_payload")
  discoveredAt   DateTime  @default(now()) @map("discovered_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  seekerJobMatches   SeekerJobMatch[]
  seekerApplications SeekerApplication[]

  @@index([source, discoveredAt(sort: Desc)], map: "idx_discovered_jobs_source")
  @@index([status], map: "idx_discovered_jobs_status")
  @@map("discovered_jobs")
}

