# App
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# Database (Railway/Render managed Postgres or local)
DATABASE_URL=postgresql://crewly:changeme@localhost:5432/crewly
DIRECT_URL=postgresql://crewly:changeme@localhost:5432/crewly

# Redis (Railway/Render managed Redis or local)
REDIS_URL=redis://localhost:6379

# Auth (generate: openssl rand -hex 32)
SESSION_SECRET=change-me-generate-with-openssl-rand-hex-32

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (for text-embedding-3-small)
OPENAI_API_KEY=sk-...

# Search APIs
TAVILY_API_KEY=
JSEARCH_RAPIDAPI_KEY=

# Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# hh.ru (employer account required)
HH_EMPLOYER_TOKEN=
HH_EMPLOYER_ID=
HH_USER_AGENT=Crewly/1.0 (contact@crewly.uz)
HH_WEBHOOK_SECRET=
HH_SPECIALIZATIONS=

# hh.ru OAuth (candidate account linking — register app at dev.hh.ru)
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=http://localhost:3000/auth/hh/callback

# LinkedIn (RapidAPI for sourcing, credentials for auto-apply)
LINKEDIN_RAPIDAPI_KEY=
LINKEDIN_RAPIDAPI_HOST=fresh-linkedin-profile-data.p.rapidapi.com
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Google (OAuth + Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GOOGLE_REFRESH_TOKEN=

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

# Email (Resend)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# S3-compatible storage (for PDF dossiers)
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# Payment webhooks (HMAC-SHA256 of JSON body in X-Webhook-Signature)
PAYMENT_WEBHOOK_SECRET=

# Payment Gateway (Payme)
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=

# Observability
LOG_LEVEL=info
SENTRY_DSN=
