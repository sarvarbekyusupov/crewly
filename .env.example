# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://myhr:changeme@localhost:5432/myhr
DIRECT_URL=postgresql://myhr:changeme@localhost:5432/myhr
POSTGRES_USER=myhr
POSTGRES_PASSWORD=changeme
POSTGRES_DB=myhr

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:changeme@localhost:6379
REDIS_PASSWORD=changeme

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
SESSION_SECRET=at_least_32_random_characters_here_xxxx

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=at_least_32_random_chars_for_jwt_access_xxxx
JWT_REFRESH_SECRET=at_least_32_random_chars_for_jwt_refresh_xxxx
JWT_ACCESS_TTL_SECONDS=900

# ── Google OAuth (candidate portal) ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.example.com/api/v1/candidate-auth/google/callback

# ── Docker images (overridden by Jenkins .env.image during deploy) ────────────
IMAGE_BACKEND=registry.example.com/my-hr/backend:latest
IMAGE_FRONTEND=registry.example.com/my-hr/frontend:latest

# ── LLM providers (at least one required for AI features) ────────────────────
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

AWS_BEARER_TOKEN_BEDROCK=
AWS_BEDROCK_REGION=us-east-1

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=noreply@yourdomain.uz
BULL_BOARD_PASSWORD=changeme_at_least_8_chars

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── Payme (Uzbek payment gateway) ────────────────────────────────────────────
PAYME_MERCHANT_KEY=
PAYMENT_WEBHOOK_SECRET=

# ── S3-compatible storage ─────────────────────────────────────────────────────
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# ── hh.ru integration ─────────────────────────────────────────────────────────
HH_EMPLOYER_TOKEN=
HH_EMPLOYER_ID=
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=https://api.example.com/api/v1/candidate-portal/hh/callback
HH_USER_AGENT=AIRecruiting/1.0 (contact@yourdomain.uz)
# comma-separated specialization codes
HH_SPECIALIZATIONS=1.221

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
